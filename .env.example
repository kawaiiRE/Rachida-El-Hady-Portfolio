NUXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact API
# The backend that receives the contact form. Defaults to https://api.rachida.dev.
# Its CORS allowlist is pinned to the production origins, so a dev server on localhost
# cannot call the production API from the browser; point this at a local instance.
# NUXT_PUBLIC_CONTACT_API_BASE_URL=http://127.0.0.1:5020

# Optional Google Analytics 4 measurement ID
# NUXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudflare Pages build
# NITRO_PRESET=cloudflare_pages
