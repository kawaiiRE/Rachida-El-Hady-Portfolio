# EmailJS Configuration
# Get these values from https://www.emailjs.com/
NUXT_PUBLIC_SITE_URL=https://your-domain.com
NUXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here
NUXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NUXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here

# Analytics
NUXT_PUBLIC_ANALYTICS_ENABLED=true
NUXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NUXT_PUBLIC_ANALYTICS_ENDPOINT=/api/analytics/event
ANALYTICS_LOG_PATH=.data/analytics-events.jsonl
ANALYTICS_ADMIN_TOKEN=change_me_to_a_private_token
ANALYTICS_IP_SALT=change_me_to_a_random_secret

# Backward-compatible local aliases
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
